{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "ESNext",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@mistria-guide/data-types": [
        "libs/data-types/src/index.ts"
      ],
      "@spartan-ng/helm/alert": [
        "libs/ui/ui-alert-helm/src/index.ts"
      ],
      "@spartan-ng/helm/button": [
        "libs/ui/ui-button-helm/src/index.ts"
      ],
      "@spartan-ng/helm/card": [
        "libs/ui/ui-card-helm/src/index.ts"
      ],
      "@spartan-ng/helm/checkbox": [
        "libs/ui/ui-checkbox-helm/src/index.ts"
      ],
      "@spartan-ng/helm/dialog": [
        "libs/ui/ui-dialog-helm/src/index.ts"
      ],
      "@spartan-ng/helm/form-field": [
        "libs/ui/ui-form-field-helm/src/index.ts"
      ],
      "@spartan-ng/helm/hover-card": [
        "libs/ui/ui-hover-card-helm/src/index.ts"
      ],
      "@spartan-ng/helm/icon": [
        "libs/ui/ui-icon-helm/src/index.ts"
      ],
      "@spartan-ng/helm/input": [
        "libs/ui/ui-input-helm/src/index.ts"
      ],
      "@spartan-ng/helm/label": [
        "libs/ui/ui-label-helm/src/index.ts"
      ],
      "@spartan-ng/helm/pagination": [
        "libs/ui/ui-pagination-helm/src/index.ts"
      ],
      "@spartan-ng/helm/popover": [
        "libs/ui/ui-popover-helm/src/index.ts"
      ],
      "@spartan-ng/helm/radio-group": [
        "libs/ui/ui-radio-group-helm/src/index.ts"
      ],
      "@spartan-ng/helm/select": [
        "libs/ui/ui-select-helm/src/index.ts"
      ],
      "@spartan-ng/helm/skeleton": [
        "libs/ui/ui-skeleton-helm/src/index.ts"
      ],
      "@spartan-ng/helm/spinner": [
        "libs/ui/ui-spinner-helm/src/index.ts"
      ],
      "@spartan-ng/helm/tooltip": [
        "libs/ui/ui-tooltip-helm/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
